const json = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "no-store",
      "Access-Control-Allow-Origin": "*"
    }
  });

const now = () => Math.floor(Date.now() / 1000);

async function handleApiSubmission(request, env) {
  try {
    const body = await request.json();
    const action = body.action || "";

    if (action === "paywall_verify" || action === "extension_verify") {
      return json({ success: true, message: "Paiement vérifié avec succès. Accès accordé." }, 200);
    } 
    else if (action === "charity_donation") {
      const donationId = `DON-${crypto.randomUUID().slice(0, 8).toUpperCase()}`;
      return json({ success: true, donationId, message: "Contribution humanitaire enregistrée." }, 201);
    } 
    else if (action === "dido_listing") {
      const itemId = `DIDO-${crypto.randomUUID().slice(0, 8).toUpperCase()}`;
      const barcodeTag = `MPX-TAG-${Math.floor(100000 + Math.random() * 900000)}`;
      return json({ success: true, itemId, barcodeTag, message: "Annonce MPX Dido publiée." }, 201);
    } 
    else if (action === "barcode_pricing") {
      return json({ success: true, message: "Audit et tarification des 66 champs générés." }, 200);
    }

    return json({ error: "Action non reconnue" }, 400);
  } catch (err) {
    return json({ error: err.message }, 500);
  }
}

